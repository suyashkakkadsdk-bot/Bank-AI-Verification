# Database connection (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/bank_ai_verification

# Test database (optional, for running tests)
# Must be a different database than DATABASE_URL
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/bank_ai_verification_test

# Admin login rate limiting (optional, defaults shown)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_COOLDOWN_SECONDS=900